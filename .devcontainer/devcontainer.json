{
  "name": "GCP ADK Agent (Python 3.12 + uv)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/google-cloud-cli:1": {
      "installGkeGcloudAuthPlugin": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "googlecloudtools.cloudcode"
      ]
    }
  },

  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && source $HOME/.cargo/env && uv pip install 'google-cloud-aiplatform[adk]' && gcloud auth application-default login",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Agent App"
    }
  }
}
