# Copy to `.env` (project root) or `src/agents/MasterMechanicalAgent/.env`.
# Do not commit real secrets.

# --- Gemini / Google GenAI ---
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_GENAI_API_KEY=   # copied to GOOGLE_API_KEY by agent.py if unset

# --- BigQuery ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=mastermechanical

# --- Agent behavior ---
# AGENT_TIMEZONE=America/Phoenix
# MASTER_MECHANICAL_OWNER_EMAIL=owner@example.com

# --- AG-UI FastAPI backend (local dev) ---
# AG_UI_ALLOW_UNAUTHENTICATED=true   # required for local uvicorn without invoker secret
# AG_UI_INVOKER_SECRET=              # required in production (set on backend + Next.js)
# AG_UI_CORS_ORIGINS=http://localhost:3000

# --- Next.js frontend (frontend/.env.local) ---
# AUTH_SECRET=
# NEXTAUTH_SECRET=                   # fallback if AUTH_SECRET unset
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_URL=http://localhost:3000
# AG_UI_BACKEND_URL=http://localhost:8000/
# AG_UI_INVOKER_SECRET=                # must match backend when set
